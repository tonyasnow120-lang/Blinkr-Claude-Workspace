<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runner entitlements — enables iOS Universal Links (GAP-9)
  Add the Associated Domains capability in Xcode or via this file.
  Ensure https://blinkr.app/.well-known/apple-app-site-association is served
  by the backend with the correct Content-Type and appID.
-->
<plist version="1.0">
<dict>
    <!-- Universal Links (associated-domains) removed for now: the
         provisioning profile must carry every entitlement listed here or
         codesign fails the whole build. blinkr.app universal links aren't
         operational yet (auth uses the blinkr:// custom scheme). Re-add
         com.apple.developer.applesignin's sibling key
         com.apple.developer.associated-domains = [applinks:blinkr.app]
         once the domain + App ID capability + profile are configured. -->
    <key>com.apple.developer.applesignin</key>
    <array>
        <string>Default</string>
    </array>
</dict>
</plist>
